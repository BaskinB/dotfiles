# .chezmoiignore
# Patterns match TARGET paths (e.g. .config/nvim), not source names (dot_config/nvim).
# This file is a template, so chezmoi template conditionals work here.

# --- Repo-only files: never apply these to the home directory ---
README.md
LICENSE*
.gitattributes
.gitignore

# --- Transitional: delete these from the repo, then remove the lines ---
# Vendored PowerShell modules (installed by run_onchange_after_install-pwsh-modules.ps1)
Documents/PowerShell/Modules
# Upstream kickstart.nvim meta files
.config/nvim/README.md
.config/nvim/LICENSE.md
.config/nvim/.github
.config/nvim/doc
# Backups, installer receipts, and tool state that churns on its own
.config/starship/starship.toml.bak
.config/termato
.config/scoop
.config/nodemon.json
.config/gh/hosts.yml
.config/lazygit/empty_config.yml

# --- Platform guard: this repo is Windows-only ---
{{ if ne .chezmoi.os "windows" }}
AppData
Documents
.vscode
{{ end }}
