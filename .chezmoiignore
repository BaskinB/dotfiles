# .chezmoiignore
# Patterns match TARGET paths (e.g. .config/nvim), not source names (dot_config/nvim).
# This file is a template, so chezmoi template conditionals work here.

# --- Repo-only files: never apply these to the home directory ---
README.md
LICENSE*
.gitattributes
.gitignore

# --- Managed outside chezmoi ---
# Modules are installed by run_onchange_after_install-pwsh-modules.ps1
Documents/PowerShell/Modules
Documents/PowerShell/Help

# --- Machine state: keep out of the repo even if re-added by accident ---
.config/gh/hosts.yml
.config/scoop/config.json
.config/termato
.config/nodemon.json

# --- Platform guard: this repo is Windows-only ---
{{ if ne .chezmoi.os "windows" }}
AppData
Documents
.vscode
{{ end }}