{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "C:/Users/Baskin/.config/fastfetch/logo.txt",
    "color": {
      "1": "white",
      "2": "green",
    },
    "position": "right",
  },
  "display": {
    "separator": " │ ",
    "constants": [
      "────────────", // {$1}, used in Custom module
      "│",
    ],
    "color": "white",
  },
  "modules": [
    {
      "type": "custom",
      "format": "  ╭{$1}╮",
    },
    {
      "type": "title",
      "key": "  {#white}│ {#magenta}  {#white}user   ",
      "format": "{user-name}",
      "outputColor": "magenta",
    },
    {
      "type": "title",
      "key": "  {#white}│ {#yellow}󰍉  {#white}hname  ",
      "format": "{host-name}",
      "outputColor": "yellow",
    },
    {
      "type": "os",
      "key": "  {#white}│ {#green}󰻀  {#white}distro ",
      "outputColor": "green",
    },
    {
      "type": "kernel",
      "key": "  {#white}│ {#blue}󰌢  {#white}kernel ",
      "outputColor": "blue",
    },
    {
      "type": "uptime",
      "key": "  {#white}│ {#cyan}  {#white}uptime ",
      "outputColor": "cyan",
      "format": "{days}d {hours}h {minutes}m",
    },
    {
      "type": "shell",
      "key": "  {#white}│ {#blue}  {#white}shell  ",
      "outputColor": "blue",
    },
    {
      "type": "terminal",
      "key": "  {#white}│ {#red}  {#white}term   ",
      "outputColor": "red",
    },
    {
      "type": "packages",
      "key": "  {#white}│ {#green}󰏖  {#white}pkgs   ",
      "outputColor": "green",
    },
    {
      "type": "memory",
      "key": "  {#white}│ {#yellow}󰍛  {#white}memory ",
      "outputColor": "yellow",
    },
    {
      "type": "custom",
      "format": "  ├{$1}┤",
    },
    {
      "type": "colors",
      "key": "  │ 󰏘  colors ",
      "symbol": "circle",
    },
    {
      "type": "custom",
      "format": "  ╰{$1}╯",
    },
  ],
}
