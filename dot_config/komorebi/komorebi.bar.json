{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.34/schema.bar.json",
  "monitor": 0,
  "font_family": "JetBrains Mono",
  "height": 40,
  "transparency_alpha": 0,
  "margin": {
    "horizontal": 20,
    "vertical": [10, 0]
  },
  "grouping": {
    "kind": "Widget",
    "style": "DefaultWithShadowB4O1S3",
    "rounding": 10,
    "transparency_alpha": 250
  },
  "left_widgets": [
    {
      "Komorebi": {
        "workspaces": {
          "enable": true,
          "hide_empty_workspaces": false
        },
        "layout": {
          "enable": true,
          "display": "Icon"
        },
        "workspace_layer": {
          "enable": true
        },
        "focused_window": {
          "enable": true,
          "display": "IconAndText"
        }
      }
    }
  ],
  "right_widgets": [
    {
      "Media": {
        "enable": true
      }
    },
    {
      "Cpu": {
        "enable": true
      }
    },
    {
      "Memory": {
        "enable": true
      }
    },
    {
      "Network": {
        "enable": true,
        "show_total_data_transmitted": false,
        "show_network_activity": false
      }
    },
    {
      "Date": {
        "enable": true,
        "format": "MonthDateYear"
      }
    },
    {
      "Time": {
        "enable": true,
        "format": "TwelveHour"
      }
    }
  ]
}
