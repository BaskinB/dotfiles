{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.36/schema.bar.json",
  "monitor": 0,
  "font_family": "Maple Mono NF",
  "height": 38,
  "transparency_alpha": 0,
  "theme": {
    "palette": "Custom",
    "colours": {
      "base_00": "#140e1a",
      "base_01": "#191120",
      "base_02": "#3d375e",
      "base_03": "#050406",
      "base_04": "#cdccce",
      "base_05": "#edecee",
      "base_06": "#e0def4",
      "base_07": "#ffffff",
      "base_08": "#ff6767",
      "base_09": "#ffca85",
      "base_0a": "#f477ff",
      "base_0b": "#8effd9",
      "base_0c": "#4eddff",
      "base_0d": "#a277ff",
      "base_0e": "#e92bff",
      "base_0f": "#61ffca"
    },
    "accent": "Base0E",
    "auto_select_fill": "Base0F",
    "auto_select_text": "Base04"
  },
  "margin": {
    "horizontal": 8,
    "vertical": [8, 0]
  },
  "grouping": {
    "kind": "Widget",
    "style": "DefaultWithShadowB4O0S3",
    "rounding": 8,
    "transparency_alpha": 200
  },
  "left_widgets": [
    {
      "Komorebi": {
        "workspaces": {
          "enable": true,
          "hide_empty_workspaces": true
        },
        "layout": {
          "enable": true,
          "display": "Icon"
        },
        "workspace_layer": {
          "enable": true
        },
        "focused_window": {
          "enable": true,
          "display": "IconAndText"
        }
      }
    }
  ],
  "center_widgets": [
    {
      "Date": {
        "enable": true,
        "format": "MonthDateYear"
      }
    },
    {
      "Time": {
        "enable": true,
        "format": "TwelveHour"
      }
    }
  ],
  "right_widgets": [
    {
      "Media": {
        "enable": true
      }
    },
    {
      "Cpu": {
        "enable": true
      }
    },
    {
      "Memory": {
        "enable": true
      }
    }
  ]
}
